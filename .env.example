# ---------------------------------------------------------------------------
# Database — Neon Postgres. Use the POOLED connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# AI provider. Models are chosen by role, never by name at the call site, so
# switching provider is one variable:
#   google | openai | openrouter | gateway
# ---------------------------------------------------------------------------
AI_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional per-role overrides. Defaults live in apps/api/src/agents/provider.ts.
# ROUTER_MODEL="gemini-3.5-flash-lite"
# AGENT_MODEL="gemini-3.5-flash"
# SUMMARY_MODEL="gemini-3.5-flash-lite"

# ---------------------------------------------------------------------------
# Fallback provider — strongly recommended.
#
# When the primary fails with a retryable error (quota, rate limit, overloaded)
# the model layer transparently retries the same call against this model on
# OpenRouter. Gemini's free tier is 5 requests/minute and a single turn costs
# two or three, so without this a demo stalls almost immediately.
#
# Set both to enable; leave OPENROUTER_API_KEY empty to disable.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
FALLBACK_MODEL="google/gemini-3.5-flash-lite"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT="3001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"

# Older turns are compacted into a rolling summary past this budget.
CONTEXT_TOKEN_BUDGET="6000"
CONTEXT_KEEP_RECENT_MESSAGES="8"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001"
